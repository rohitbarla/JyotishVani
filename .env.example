# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional SMTP Email Dispatch Configuration (for live external daily horoscope delivery)
# Can also be configured directly via Kendra Staff Portal -> Email Scheduler Tab
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=

# Optional Live SMS Gateways for OTP verification
# Fast2SMS (Indian SMS Gateway - https://www.fast2sms.com)
FAST2SMS_API_KEY=

# Twilio SMS & WhatsApp Gateway (Global)
# For WhatsApp Sandbox, set TWILIO_WHATSAPP_NUMBER="whatsapp:+17372508034"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_CONTENT_SID=HX8bf9b1df2bbb26ad36c480ab6af0d150

# Meta / WhatsApp Cloud API Gateway (Direct Graph API)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Custom WhatsApp Webhook / Gateway Endpoint (e.g., UltraMsg, MSG91, Waboxapp)
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=

# MSG91 India SMS Gateway
MSG91_AUTH_KEY=
